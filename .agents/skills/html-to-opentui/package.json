{
  "name": "html-to-opentui-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Source-linked HTML/CSS/JS prototype auditing for OpenTUI",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract_prototype.ts",
    "licenses:generate": "node scripts/dependency_notices.ts",
    "licenses:check": "node scripts/dependency_notices.ts --check",
    "check": "npm run typecheck && npm test && npm run licenses:check"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "postcss-value-parser": "4.2.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0"
  },
  "license": "MIT"
}
