{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "type": "object",
  "properties": {
    "automatic": {
      "anyOf": [
        {
          "$ref": "#/definitions/Automatic"
        },
        {
          "type": "null"
        }
      ]
    },
    "downloadRequired": {
      "type": "boolean"
    },
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "origin": {
      "type": "string"
    },
    "updated": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "sourceHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogHash": {
      "type": "string"
    },
    "catalog": {
      "$ref": "#/definitions/Catalog"
    }
  },
  "additionalProperties": false,
  "required": [
    "outputVersion",
    "action",
    "origin",
    "updated",
    "source",
    "catalogHash",
    "catalog"
  ],
  "definitions": {
    "Automatic": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/AutomaticStatus"
        },
        "attemptId": {
          "type": "string"
        },
        "attemptedAt": {
          "type": "string"
        },
        "retryAt": {
          "type": "string"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "attemptId",
        "attemptedAt",
        "retryAt"
      ]
    },
    "AutomaticStatus": {
      "type": "string",
      "enum": [
        "checking",
        "updated",
        "unchanged",
        "failed"
      ]
    },
    "Action": {
      "type": "string",
      "enum": [
        "status",
        "update",
        "auto_update"
      ]
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelPrice"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "verifiedAt",
        "policy",
        "currency",
        "models"
      ]
    },
    "ModelPrice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "rates": {
          "$ref": "#/definitions/Rates"
        },
        "longContext": {
          "anyOf": [
            {
              "$ref": "#/definitions/LongContext"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "source",
        "rates"
      ]
    },
    "Rates": {
      "type": "object",
      "properties": {
        "input": {
          "type": [
            "string",
            "null"
          ]
        },
        "cacheRead": {
          "type": [
            "string",
            "null"
          ]
        },
        "cacheCreate": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "LongContext": {
      "type": "object",
      "properties": {
        "inputAbove": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rates": {
          "$ref": "#/definitions/Rates"
        }
      },
      "additionalProperties": false,
      "required": [
        "inputAbove",
        "rates"
      ]
    }
  }
}
