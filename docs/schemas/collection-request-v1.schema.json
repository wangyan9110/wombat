{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "action": {
      "default": "status",
      "allOf": [
        {
          "$ref": "#/definitions/Action"
        }
      ]
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/definitions/Mode"
        },
        {
          "type": "null"
        }
      ]
    },
    "roots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceInstanceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "after": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "status",
        "events",
        "configure",
        "pause",
        "resume"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "logs",
        "hooks"
      ]
    }
  }
}
