            {
              "$ref": "#/definitions/TokenBasis"
            }
          ]
        },
        "maxTokens": {
          "description": "Maximum of bucket analyzed subtotals; not necessarily a complete total.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCost": {
          "type": [
            "string",
            "null"
          ]
        },
        "peakTokenDates": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "peakCostDates": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "peakTokenScopes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Scope"
          }
        },
        "peakCostScopes": {
          "type": "array",
          "items": {
