      "properties": {
        "methodVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "scope": {
          "$ref": "#/definitions/TokenAnalysisScope"
        },
        "fields": {
          "$ref": "#/definitions/TokenFields"
        },
        "totalAnalysis": {
          "description": "Independent analysis; immutable historical review items may contain only\nthe native observations captured when the user made the decision.",
          "anyOf": [
            {
              "$ref": "#/definitions/AnalyzedTokenTotal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "methodVersion",
        "scope",
        "fields"
      ]
    },
    "TokenAnalysisScope": {
      "type": "string",
      "enum": [
        "selected_canonical_measurements"
      ]
    },
    "TokenFields": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "cacheRead": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "cacheCreate": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "output": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "reasoning": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "total": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "rawInput": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "cacheRead",
        "cacheCreate",
        "output",
        "reasoning",
        "total",
        "rawInput"
      ]
    },
    "ObservedTokenSubtotal": {
      "description": "An observed subtotal never implies that unavailable records contributed zero.",
      "type": "object",
      "properties": {
        "observedSubtotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conflictingRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "indeterminateRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "coveredRecords",
        "missingRecords",
        "conflictingRecords",
        "invalidRecords",
        "indeterminateRecords"
      ]
    },
    "AnalyzedTokenTotal": {
      "type": "object",
      "properties": {
        "methodVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "subtotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recordedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "calculatedRecords": {
          "description": "Unavailable native totals use recorded input (including caches) plus output\nonly for an identified response grain. Reasoning is already in output.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailableRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overflowRecords": {
          "description": "Alternative records excluded by individual or combined safe-integer limits.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "methodVersion",
        "coveredRecords",
        "recordedRecords",
        "calculatedRecords",
        "unavailableRecords",
        "overflowRecords"
      ]
    },
    "PriceResult": {
      "type": "object",
      "properties": {
        "currency": {
