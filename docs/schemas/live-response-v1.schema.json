            {
              "type": "null"
            }
          ]
        },
        "distribution": {
          "anyOf": [
            {
              "$ref": "#/definitions/Distribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "priceUpdate": {
          "anyOf": [
            {
              "$ref": "#/definitions/Automatic"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/definitions/Freshness"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputVersion": {
          "type": "integer",
          "minimum": 5,
          "maximum": 5
        },
        "action": {
          "$ref": "#/definitions/Action"
        },
        "snapshotRef": {
          "$ref": "#/definitions/SnapshotRef"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "availableRange": {
          "$ref": "#/definitions/AvailableRange"
        },
        "summary": {
          "$ref": "#/definitions/UsageSummary"
