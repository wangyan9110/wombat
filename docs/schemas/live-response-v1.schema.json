            "$ref": "#/definitions/Item"
          }
        },
        "page": {
          "$ref": "#/definitions/Page"
        },
        "quality": {
          "$ref": "#/definitions/Quality"
        }
      },
      "required": [
        "outputVersion",
        "action",
        "snapshotRef",
        "scope",
        "availableRange",
        "summary",
        "items",
        "page",
        "quality"
      ]
    },
    "Facets": {
      "description": "Observed dimensions, not a project registry or a configuration inventory.",
      "type": "object",
      "properties": {
        "discoveredThreadCount": {
          "description": "Metadata across this snapshot's authorized sources, independent of measurement/date filters.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hasUnassigned": {
          "type": "boolean"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoningEfforts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "directories",
        "hasUnassigned",
        "models",
        "reasoningEfforts",
        "agents"
      ]
