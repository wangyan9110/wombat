        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effortUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "undated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
