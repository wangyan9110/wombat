    "AutomaticStatus": {
      "type": "string",
      "enum": [
        "checking",
        "updated",
        "unchanged",
        "failed"
      ]
    },
    "Freshness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "initialScan": {
          "description": "Ephemeral task headers; no completed ledger or coverage is available yet.",
          "type": "boolean",
          "default": false
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "revision"
      ]
