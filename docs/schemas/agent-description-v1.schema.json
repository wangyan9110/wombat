{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Description",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "runtimeVersion": {
      "type": "string"
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methodDescriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "selectedMethod": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputSchema": true,
    "outputSchema": true,
    "stdinBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stdinTimeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stdoutBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "outputVersion",
    "runtimeVersion",
    "methods",
    "methodDescriptions",
    "stdinBytes",
    "stdinTimeoutMs",
    "stdoutBytes"
  ]
}
