{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "selectionVersion": {
      "type": "string"
    },
    "readView": {
      "type": "string"
    },
    "decisionRevision": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Project"
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Delivery"
      }
    },
    "allowanceChecks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AllowanceCheck"
      }
    }
  },
  "required": [
    "outputVersion",
    "action",
    "selectionVersion",
    "readView",
    "decisionRevision",
    "projects",
    "deliveries",
    "allowanceChecks"
  ],
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "preview",
        "send"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Target"
          }
        }
      },
      "required": [
        "id",
        "cwd",
        "targets"
      ]
    },
    "Target": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "suggestionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "expectedExists": {
          "type": "boolean"
        },
        "sharedProjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        }
      },
      "required": [
        "itemId",
        "suggestionIds",
        "path",
        "contentHash",
        "expectedExists",
        "sharedProjects",
        "findings"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/definitions/FindingIdentity"
        },
        "rule": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "observed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "description": "Positions and relationships only; never retain source text or command arguments.",
          "anyOf": [
            {
              "$ref": "#/definitions/StaticEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "rule",
        "status",
        "evidenceCodes"
      ]
    },
    "FindingIdentity": {
      "description": "Problem identity is independent of revisions, thresholds and check timestamps.",
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "findingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "gap": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "version"
      ]
    },
    "StaticEvidence": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "applicability": {
          "type": "string"
        },
        "declarationHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "type": [
            "string",
            "null"
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileVersion"
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BlockPosition"
          }
        },
        "relation": {
          "description": "Scope-bound owner required to prove a declared relation.",
          "anyOf": [
            {
              "$ref": "#/definitions/RelationIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReferenceEvidence"
          }
        },
        "hook": {
          "anyOf": [
            {
              "$ref": "#/definitions/HookTargetEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "method",
        "applicability",
        "versions",
        "positions",
        "references"
      ]
    },
    "FileVersion": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "path",
        "contentHash"
      ]
    },
    "BlockPosition": {
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startLine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockHash": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "startByte",
        "endByte",
        "startLine",
        "endLine",
        "blockHash"
      ]
    },
    "RelationIdentity": {
      "type": "object",
      "properties": {
        "sourceInstanceId": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "declarationPath": {
          "type": "string"
        },
        "declarationHash": {
          "type": "string"
        },
        "relationId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/RelationKind"
        }
      },
      "required": [
        "sourceInstanceId",
        "project",
        "declarationPath",
        "declarationHash",
        "relationId",
        "kind"
      ]
    },
    "RelationKind": {
      "type": "string",
      "enum": [
        "chain",
        "copy"
      ]
    },
    "ReferenceEvidence": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "baseDirectory": {
          "type": "string"
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "startLine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "target",
        "baseDirectory",
        "status",
        "startByte",
        "endByte",
        "startLine",
        "endLine"
      ]
    },
    "HookTargetEvidence": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "nativeKey": {
          "type": "string"
        },
        "registrationHash": {
          "type": "string"
        },
        "hostVersion": {
          "type": "string"
        },
        "trust": {
          "$ref": "#/definitions/HookTrust"
        },
        "target": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "nativeKey",
        "registrationHash",
        "hostVersion",
        "trust",
        "target",
        "status"
      ]
    },
    "HookTrust": {
      "type": "string",
      "enum": [
        "managed",
        "untrusted",
        "trusted",
        "modified"
      ]
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "projectId",
        "status"
      ]
    },
    "AllowanceCheck": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "assessment": {
          "$ref": "#/definitions/AllowanceAssessment"
        }
      },
      "required": [
        "projectId",
        "assessment"
      ]
    },
    "AllowanceAssessment": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/AllowanceStatus"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "validUntil": {
          "description": "An observation deadline, not a prediction that allowance recovers then.",
          "type": [
            "string",
            "null"
          ]
        },
        "bucketId": {
          "type": [
            "string",
            "null"
          ]
        },
        "windowId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "AllowanceStatus": {
      "type": "string",
      "enum": [
        "unknown",
        "available",
        "low",
        "blocked"
      ]
    }
  }
}
