{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Installation",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "action": {
      "$ref": "#/definitions/InstallationAction"
    },
    "directory": {
      "type": "string"
    },
    "status": {
      "$ref": "#/definitions/InstallationStatus"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "discovery": {
      "$ref": "#/definitions/Discovery"
    },
    "runtimeCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataStatus": {
      "$ref": "#/definitions/DataStatus"
    }
  },
  "required": [
    "outputVersion",
    "action",
    "directory",
    "status",
    "discovery",
    "runtimeCapabilities",
    "dataStatus"
  ],
  "definitions": {
    "InstallationAction": {
      "type": "string",
      "enum": [
        "install",
        "status",
        "uninstall"
      ]
    },
    "InstallationStatus": {
      "type": "string",
      "enum": [
        "absent",
        "unmanaged",
        "modified",
        "installed"
      ]
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/DiscoveryStatus"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Instance"
          }
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "instances"
      ]
    },
    "DiscoveryStatus": {
      "type": "string",
      "enum": [
        "available",
        "ambiguous",
        "disabled",
        "missing",
        "unavailable",
        "selection_changed"
      ]
    },
    "Instance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "enabled"
      ]
    },
    "DataStatus": {
      "type": "string",
      "enum": [
        "not_requested"
      ]
    }
  }
}
