{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "capabilities": {
      "$ref": "#/definitions/Capabilities"
    },
    "readView": {
      "type": [
        "string",
        "null"
      ]
    },
    "usageRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "configRevision": {
      "type": "string"
    },
    "checkedAt": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/definitions/Scope"
    },
    "authorizedProjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "$ref": "#/definitions/Summary"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Item"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Evidence"
      }
    },
    "relatedScopes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RelatedScope"
      }
    },
    "page": {
      "$ref": "#/definitions/Page"
    },
    "coverage": {
      "$ref": "#/definitions/Coverage"
    }
  },
  "required": [
    "outputVersion",
    "action",
    "capabilities",
    "configRevision",
    "checkedAt",
    "scope",
    "authorizedProjects",
    "summary",
    "items",
    "evidence",
    "relatedScopes",
    "page",
    "coverage"
