        "modelProvider": {
          "type": "string"
        },
        "apiProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchMethod": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string"
        },
        "priceRevision": {
          "type": "string"
        },
        "catalogHash": {
          "type": "string"
