        "knownCost": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ratePerMillion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "knownCost",
        "status"
      ]
