    "RelatedScope": {
      "type": "object",
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/UsageSummary"
            },
            {
              "type": "null"
            }
          ]
        }
