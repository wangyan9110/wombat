      "required": [
        "id",
        "name",
        "kind",
        "sourceInstanceId",
        "path",
        "configuredState",
        "contentHash",
        "observedAt",
        "current",
        "stale",
        "estimateStatus",
        "observation",
        "counts",
        "relatedTurns"
      ]
    },
    "Observation": {
      "type": "string",
      "enum": [
        "used",
        "loaded_only",
        "unknown"
      ]
    },
    "Counts": {
      "type": "object",
      "properties": {
        "fileReads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcomeUnknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
