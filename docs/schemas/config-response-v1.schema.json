  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "list",
        "detail",
        "evidence",
        "related_scopes",
        "capabilities"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Kind"
          }
        },
        "evidenceTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tokenEstimates": {
          "type": "boolean"
        },
        "historicalContent": {
          "type": "boolean"
        },
        "writes": {
          "type": "boolean"
        },
        "projectRegistry": {
          "type": "boolean"
        }
      },
      "required": [
        "kinds",
        "evidenceTypes",
        "tokenEstimates",
        "historicalContent",
        "writes",
        "projectRegistry"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "rule",
        "skill",
        "mcp"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "properties": {
        "currentItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "historicalItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/UsageSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currentItems",
        "historicalItems",
        "observedItems"
      ]
    },
    "UsageSummary": {
      "type": "object",
      "properties": {
        "inputTotal": {
          "description": "All input, including cache reads and writes. Existing tokens.input stays uncached.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "maximum": 9007199254740991
        },
        "cacheHitRate": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "unpricedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "maximum": 9007199254740991
        },
        "tokens": {
          "$ref": "#/definitions/TokenUsage"
        },
        "price": {
          "$ref": "#/definitions/PriceResult"
        },
        "measurementCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tokens",
        "price",
        "measurementCount"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheRead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheCreate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning": {
          "description": "Subset of output, never an additional billable category.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rawInput": {
          "description": "Source input including caches; retained for request-level price conditions.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "PriceResult": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "priceRevision": {
          "type": "string"
        },
        "cost": {
          "description": "Present only when every applicable Token category has a known amount.",
          "type": [
            "string",
            "null"
          ]
        },
        "knownCost": {
          "type": "string"
        },
        "status": {
          "description": "priced, partial, unknown",
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceComponent"
          }
        },
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceBasis"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
