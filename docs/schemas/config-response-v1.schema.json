    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "itemId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventType": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "association": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/definitions/UsageSummary"
            },
            {
              "type": "null"
            }
          ]
        }
