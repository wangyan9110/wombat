    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/Kind"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuredState": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "observedAt": {
          "type": "string"
        },
        "current": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
