        "condition": {
          "description": "standard, longContext, conditionUnknown",
          "type": "string"
        },
        "requestInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestScoped": {
          "type": "boolean"
        }
