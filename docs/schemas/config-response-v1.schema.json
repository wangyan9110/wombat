      "required": [
        "currency",
        "policy",
        "priceRevision",
        "knownCost",
        "status",
        "components",
        "basis",
        "issues"
      ]
    },
    "PriceComponent": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
