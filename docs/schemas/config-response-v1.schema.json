        "contentTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimateStatus": {
          "type": "string"
        },
        "observation": {
          "$ref": "#/definitions/Observation"
        },
        "counts": {
          "$ref": "#/definitions/Counts"
        },
        "relatedTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "anyOf": [
