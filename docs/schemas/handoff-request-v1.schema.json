{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "action": {
      "default": "preview",
      "allOf": [
        {
          "$ref": "#/definitions/Action"
        }
      ]
    },
    "roots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "projectRoots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceInstanceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "readView": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisionRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "ruleOverrides": {
      "anyOf": [
        {
          "$ref": "#/definitions/RuleOverrides"
        },
        {
          "type": "null"
        }
      ]
    },
    "suggestionIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "selectionVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "withoutSkill": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "skillSelections": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/Selection"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "preview",
        "send"
      ]
    },
    "RuleOverrides": {
      "type": "object",
      "properties": {
        "agentsBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "descriptionCharacters": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "Selection": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "projectId",
        "path"
      ]
    }
  }
}
