{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "snapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Plan"
      }
    },
    "notifications": {
      "description": "Most recent 100 notifications. New checks return only newly created notifications.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Notification"
      }
    },
    "checkedAt": {
      "type": "string"
    },
    "hostRequired": {
      "type": "boolean"
    }
  },
  "required": [
    "action",
    "outputVersion",
    "plans",
    "notifications",
    "checkedAt",
    "hostRequired"
  ],
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "list",
        "upsert",
        "remove",
        "check",
        "acknowledge"
      ]
    },
    "Plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "period": {
          "$ref": "#/definitions/Period"
        },
        "scope": {
          "description": "Identity filters and timezone only; date, undated, thread and turn filters are rejected.",
          "default": {
            "allTime": null,
            "timezone": null,
            "since": null,
            "until": null,
            "agentKind": null,
            "sourceInstanceId": null,
            "model": null,
            "modelUnknown": null,
            "effortUnknown": null,
            "undated": null,
            "reasoningEffort": null,
            "project": null,
            "projectUnknown": null,
            "threadId": null,
            "turnId": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/Scope"
            }
          ]
        },
        "tokenLimit": {
          "description": "Token budget, not an account allowance or money allocation to tools.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningRatio": {
          "description": "Fraction in (0,1]; 0.8 by default.",
          "type": [
            "number",
            "null"
          ]
        },
        "review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "period",
        "review"
      ]
    },
    "Period": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "allTime": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effortUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "undated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "description": "Exact turn inspection, always bound to a selected thread.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "sourceInstanceIds": {
          "description": "Authorized source set used for these facts and notification deduplication.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "planRevision": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NotificationKind"
        },
        "checkedAt": {
          "type": "string"
        },
        "snapshotRef": {
          "$ref": "#/definitions/SnapshotRef"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "summary": {
          "$ref": "#/definitions/UsageSummary"
        },
        "statistics": {
          "$ref": "#/definitions/TaskStatistics"
        },
        "partial": {
          "type": "boolean"
        },
        "acknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "sourceInstanceIds",
        "id",
        "planId",
        "planRevision",
        "kind",
        "checkedAt",
        "snapshotRef",
        "scope",
        "summary",
        "statistics",
        "partial",
        "acknowledged"
      ]
    },
    "NotificationKind": {
      "type": "string",
      "enum": [
        "budget_warning",
        "budget_exceeded",
        "period_review"
      ]
    },
    "SnapshotRef": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "createdAt"
      ]
    },
    "UsageSummary": {
      "type": "object",
      "properties": {
        "inputTotal": {
          "description": "All input, including cache reads and writes. Existing tokens.input stays uncached.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "maximum": 9007199254740991
        },
        "cacheHitRate": {
          "type": [
            "number",
            "null"
          ],
          "default": null
        },
        "unpricedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "default": null,
          "maximum": 9007199254740991
        },
        "tokens": {
          "$ref": "#/definitions/TokenUsage"
        },
        "tokenAnalysis": {
          "$ref": "#/definitions/TokenAnalysis"
        },
        "price": {
          "$ref": "#/definitions/PriceResult"
        },
        "measurementCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tokens",
        "tokenAnalysis",
        "price",
        "measurementCount"
      ]
    },
    "TokenUsage": {
      "type": "object",
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheRead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheCreate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning": {
          "description": "Subset of output, never an additional billable category.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rawInput": {
          "description": "Source input including caches; retained for request-level price conditions.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "TokenAnalysis": {
      "description": "Token subtotals are scoped to the canonical measurements selected by this query.\nExisting `tokens` fields remain complete totals; partial observations live here.",
      "type": "object",
      "properties": {
        "methodVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "scope": {
          "$ref": "#/definitions/TokenAnalysisScope"
        },
        "fields": {
          "$ref": "#/definitions/TokenFields"
        },
        "totalAnalysis": {
          "description": "Independent analysis; immutable historical review items may contain only\nthe native observations captured when the user made the decision.",
          "anyOf": [
            {
              "$ref": "#/definitions/AnalyzedTokenTotal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "methodVersion",
        "scope",
        "fields"
      ]
    },
    "TokenAnalysisScope": {
      "type": "string",
      "enum": [
        "selected_canonical_measurements"
      ]
    },
    "TokenFields": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "cacheRead": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "cacheCreate": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "output": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "reasoning": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "total": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        },
        "rawInput": {
          "$ref": "#/definitions/ObservedTokenSubtotal"
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "cacheRead",
        "cacheCreate",
        "output",
        "reasoning",
        "total",
        "rawInput"
      ]
    },
    "ObservedTokenSubtotal": {
      "description": "An observed subtotal never implies that unavailable records contributed zero.",
      "type": "object",
      "properties": {
        "observedSubtotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missingRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conflictingRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "invalidRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "indeterminateRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "coveredRecords",
        "missingRecords",
        "conflictingRecords",
        "invalidRecords",
        "indeterminateRecords"
      ]
    },
    "AnalyzedTokenTotal": {
      "type": "object",
      "properties": {
        "methodVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "subtotal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recordedRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "calculatedRecords": {
          "description": "Unavailable native totals use recorded input (including caches) plus output\nonly for an identified response grain. Reasoning is already in output.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailableRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "overflowRecords": {
          "description": "Alternative records excluded by individual or combined safe-integer limits.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "methodVersion",
        "coveredRecords",
        "recordedRecords",
        "calculatedRecords",
        "unavailableRecords",
        "overflowRecords"
      ]
    },
    "PriceResult": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "priceRevision": {
          "type": "string"
        },
        "cost": {
          "description": "Present only when every applicable Token category has a known amount.",
          "type": [
            "string",
            "null"
          ]
        },
        "knownCost": {
          "type": "string"
        },
        "status": {
          "description": "priced, partial, unknown",
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceComponent"
          }
        },
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PriceBasis"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "currency",
        "policy",
        "priceRevision",
        "knownCost",
        "status",
        "components",
        "basis",
        "issues"
      ]
    },
    "PriceComponent": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cost": {
          "type": [
            "string",
            "null"
          ]
        },
        "knownCost": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "ratePerMillion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "knownCost",
        "status"
      ]
    },
    "PriceBasis": {
      "type": "object",
      "properties": {
        "originalModel": {
          "type": "string"
        },
        "pricingModel": {
          "type": "string"
        },
        "modelProvider": {
          "type": "string"
        },
        "apiProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchMethod": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string"
        },
        "priceRevision": {
          "type": "string"
        },
        "catalogHash": {
          "type": "string"
        },
        "condition": {
          "description": "standard, longContext, conditionUnknown",
          "type": "string"
        },
        "requestInputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestScoped": {
          "type": "boolean"
        }
      },
      "required": [
        "originalModel",
        "pricingModel",
        "modelProvider",
        "matchMethod",
        "source",
        "verifiedAt",
        "priceRevision",
        "catalogHash",
        "condition",
        "requestScoped"
      ]
    },
    "TaskStatistics": {
      "type": "object",
      "properties": {
        "selectedTask": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskTypicality"
            },
            {
              "type": "null"
            }
          ]
        },
        "methodVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "quantileMethod": {
          "description": "Linear interpolation at (n-1)p, shared with timing distributions.",
          "type": "string"
        },
        "population": {
          "$ref": "#/definitions/TaskPopulation"
        },
        "dimension": {
          "anyOf": [
            {
              "$ref": "#/definitions/Presentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "description": "A task using several models occurs in each model population; counts are not additive.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaskStatisticsGroup"
          }
        },
        "growth": {
          "anyOf": [
            {
              "$ref": "#/definitions/TaskGrowth"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "methodVersion",
        "quantileMethod",
        "population",
        "groups"
      ]
    },
    "TaskTypicality": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completePopulationTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "percentileRank": {
          "description": "Midrank: (number below + half of ties) / complete sample size.",
          "type": [
            "number",
            "null"
          ]
        },
        "aboveP90": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "threadId",
        "completePopulationTasks"
      ]
    },
    "TaskPopulation": {
      "type": "object",
      "properties": {
        "measuredTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completeTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incompleteTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completeTaskTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "meanTokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "medianTokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "p90Tokens": {
          "type": [
            "number",
            "null"
          ]
        },
        "unassignedUsage": {
          "$ref": "#/definitions/UsageSummary"
        }
      },
      "required": [
        "measuredTasks",
        "completeTasks",
        "incompleteTasks",
        "unassignedUsage"
      ]
    },
    "Presentation": {
      "type": "string",
      "enum": [
        "distribution",
        "details",
        "projects",
        "models"
      ]
    },
    "TaskStatisticsGroup": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "population": {
          "$ref": "#/definitions/TaskPopulation"
        }
      },
      "required": [
        "population"
      ]
    },
    "TaskGrowth": {
      "type": "object",
      "properties": {
        "baselineScope": {
          "$ref": "#/definitions/Scope"
        },
        "baseline": {
          "$ref": "#/definitions/TaskPopulation"
        },
        "taskCountDelta": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "meanTokensDelta": {
          "type": [
            "number",
            "null"
          ]
        },
        "taskCountContribution": {
          "description": "Symmetric arithmetic decomposition: ΔN × (μ0+μ1)/2.\nOnly available for complete, nonempty populations; never a causal attribution.",
          "type": [
            "number",
            "null"
          ]
        },
        "perTaskContribution": {
          "description": "Δμ × (N0+N1)/2; sums with count contribution to attributed token growth.",
          "type": [
            "number",
            "null"
          ]
        },
        "attributedTokenDelta": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unassignedTokenDelta": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "baselineScope",
        "baseline",
        "taskCountDelta"
      ]
    }
  }
}
