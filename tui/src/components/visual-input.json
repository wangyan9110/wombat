{
  "cell": { "width": 8, "height": 20 },
  "tokens": {
    "--background": "background",
    "--border": "controlBorder",
    "--strong-border": "selectedBorder",
    "--selected": "selectedBackground",
    "--surface": "fieldBackground"
  },
  "assets": { "brand": { "svg": "../../../assets/wombat-logo-compact.svg" } },
  "styles": {
    "period": {
      "css": "border: 1px solid var(--border); border-radius: 3px; padding: 4px 10px; background: var(--background)",
      "borderBackdrop": "var(--background)"
    },
    "periodActive": {
      "css": "border-color: var(--strong-border); background: var(--selected)",
      "borderBackdrop": "var(--background)"
    },
    "metric": {
      "css": "border: 1px solid var(--strong-border); border-radius: 3px; padding: 3px 4px; background: var(--surface)",
      "borderBackdrop": "var(--background)"
    }
  }
}
